  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run typecheck && bun run build && bun run test",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit"
